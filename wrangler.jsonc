{
  // Static files only: no script ("main"), so no request runs code.
  // No account_id here: the deploy passes it from its protected environment.
  "name": "vergalin",
  "compatibility_date": "2026-11-01",
  // The public addresses are only the custom domains, attached once by hand; www redirects to the bare domain.
  "workers_dev": false,
  "preview_urls": false,
  // No request logs, matching the privacy page: logging is on by default for a new Worker.
  "observability": { "enabled": false },
  "assets": {
    "directory": "./public",
    // An unknown path gets public/404.html with status 404.
    "not_found_handling": "404-page"
  }
}
